# --- Next.js (.env.local) ----------------------------------------------------
# Written for you by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# --- Convex deployment (NOT this file) ---------------------------------------
# Server secrets live on the Convex deployment. Set them with
#   npx convex env set NAME value          (add --prod for production)
#
#   JWT_PRIVATE_KEY, JWKS     auth signing keys (see README "Auth keys")
#   SITE_URL                  e.g. http://localhost:3000 or https://bossom.app
#   AUTH_RESEND_KEY           Resend API key, for sign-up and reset codes
#   AUTH_EMAIL_FROM           e.g. "Bossom <no-reply@yourdomain.com>" (verified in Resend)
#   CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET
#   GCLOUD_MODEL_ENDPOINT     inference service base URL; must serve POST /api/analyze (README)
#   GCLOUD_API_KEY            optional, sent as X-API-Key
#   Dev deployments only:
#   DEV_LOG_AUTH_CODES=true   print codes to `npx convex logs` instead of emailing
#   ANALYSIS_MOCK=true        random results when no model endpoint is set

# --- One-off Supabase migration (scripts/migrate-from-supabase.ts) -----------
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Personal access token; lets migrated users keep their passwords
SUPABASE_ACCESS_TOKEN=
# The migration copies images, so it needs Cloudinary locally as well
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
